{
  "$schema": "https://biomejs.dev/schemas/2.1.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/node_modules", "!**/dist"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/engine/src/types.ts",
        "packages/engine/src/config.ts",
        "packages/engine/src/deck.ts"
      ],
      "assist": {
        "enabled": false
      }
    },
    {
      "includes": [
        "packages/engine/src/legality.ts",
        "packages/engine/src/reduce.ts",
        "packages/engine/src/scoring.ts",
        "packages/engine/src/validate.ts",
        "packages/engine/src/view.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedFunctionParameters": "off"
          }
        }
      }
    }
  ]
}
